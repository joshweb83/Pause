{
  "version": 2,
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "regions": ["icn1"],
  "github": {
    "enabled": true,
    "autoAlias": true,
    "silent": false,
    "autoJobCancelation": true
  },
  "env": {
    "NEXT_PUBLIC_API_URL": "@pause_api_url"
  },
  "build": {
    "env": {
      "NEXT_PUBLIC_API_URL": "@pause_api_url"
    }
  }
}
