# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/pause_db

# Storage Configuration
STORAGE_TYPE=local  # 'local' or 's3'
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=pause-storage
AWS_REGION=us-east-1

# Application URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_SECRET=your-jwt-secret-key-change-this
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OCR Configuration
TESSERACT_PATH=/usr/bin/tesseract
OCR_LANGUAGES=eng,kor  # Comma-separated list of language codes
OCR_CONFIDENCE_THRESHOLD=60

# Video Processing
FRAME_EXTRACTION_FPS=1  # Extract 1 frame per second
MAX_VIDEO_SIZE_MB=500
DUPLICATE_THRESHOLD=0.95  # Similarity threshold for duplicate detection

# AI Features (Optional)
OPENAI_API_KEY=your_openai_api_key
ENABLE_AI_TAGGING=false
ENABLE_AI_SUMMARY=false

# YouTube
YOUTUBE_DL_PATH=/usr/local/bin/yt-dlp

# Email (for notifications, optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Redis (for job queues, optional)
REDIS_URL=redis://localhost:6379/0

# Development
DEBUG=true
LOG_LEVEL=INFO
